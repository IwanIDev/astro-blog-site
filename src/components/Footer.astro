---
import childProcess from "child_process";
 
// obtain Git commit hash
const hash = childProcess
  .execSync("git rev-parse --short HEAD")
  .toString()
  .trim();

const year = new Date().getFullYear();
---
<div class="flex flex-col gap-0 footer mx-auto text-center">
  <p class="m-0 p-0 text-sm text-gray-500">
  &copy; {year} Iwan Ingman. All rights reserved.
  </p>
  <p class="m-0 p-0 text-sm text-gray-500">
  (commit {hash})
  </p>
</div>

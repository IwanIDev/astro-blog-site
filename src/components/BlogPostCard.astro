---
interface Props {
  title: string;
  slug: string;
  description: string;
  author: string;
  publishDate: Date;
}

const { title, slug, description, author, publishDate } = Astro.props as Props;

const dateFormatter = new Intl.DateTimeFormat('en-GB', {
  day: '2-digit',
  month: 'long',
  year: 'numeric',
});
---

<div class="flex pb-4 md:pb-2 pt-3 flex-col md:flex-row items-start">
  <div class="flex-auto md:w-9/12">
    <h1 class="text-xl">{title}</h1>
  </div>
  <div class="md:w-3/12 md:pl-4 md:shrink-0 text-sm relative top-px text-gray-400">
    {dateFormatter.format(publishDate)}
  </div>
</div>

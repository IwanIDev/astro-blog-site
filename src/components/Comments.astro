<div class="rounded-xl border border-white/10 bg-white/5 px-4 py-5 text-sm text-gray-400">
	<h1 class="text-lg font-bold mb-2">Comments</h1>
	<div id="remark42">
		Comments loading...
	</div>
</div>

<script is:inline>
  const remark42Host = "https://comments.iwaningman.com";
  const remark42SiteId = "www.iwaningman.com";
  const remark42ScriptId = "remark42-embed-script";

  let remark42Instance = null;

  function getRemark42Url() {
    return window.location.origin + window.location.pathname;
  }

  function setRemark42Config() {
    window.remark_config = {
      host: remark42Host,
      site_id: remark42SiteId,
      url: getRemark42Url(),
      page_title: document.title,
      theme: "dark",
      components: ["embed"],
    };
  }

  function loadRemark42Script() {
    setRemark42Config();

    if (document.getElementById(remark42ScriptId)) return;

    const script = document.createElement("script");
    script.id = remark42ScriptId;
    script.async = true;
    script.defer = true;
    script.src = `${remark42Host}/web/embed.js`;
    document.body.appendChild(script);
  }

  function destroyRemark42() {
    if (remark42Instance) {
      remark42Instance.destroy();
      remark42Instance = null;
    }
  }

  function mountRemark42() {
    const container = document.getElementById("remark42");
    if (!container) return;

    if (!window.REMARK42) return;

    setRemark42Config();
    destroyRemark42();
    container.innerHTML = "";
    remark42Instance = window.REMARK42.createInstance({
      node: container,
      host: remark42Host,
      site_id: remark42SiteId,
      url: getRemark42Url(),
      page_title: document.title,
      theme: "dark",
      components: ["embed"],
    });
  }

  function initRemark42() {
    destroyRemark42();

    const container = document.getElementById("remark42");
    if (!container) return;

    loadRemark42Script();

    if (window.REMARK42) {
      mountRemark42();
      return;
    }

    window.addEventListener("REMARK42::ready", mountRemark42, { once: true });
  }

  initRemark42();

  document.addEventListener("astro:page-load", () => {
    initRemark42();
  });
</script>

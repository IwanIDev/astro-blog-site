---
import "@/styles/global.css"

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Astro App",
  description = "Astro blog"
} = Astro.props as Props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body class="bg-slate-800 text-gray-900">
    <div class="max-w-5xl mb-40 flex flex-col md:flex-row mx-4 mt-8 md:mt-20 lg:mt-32 lg:mx-auto">
      <aside class="md:w-[200px] md:shrink-0 -mx-4 md:mx-0 md:px-0">
        <div class="lg:sticky lg:top-20">
          <div class="mb-8 px-4 md:px-0 flex flex-col md:flex-row items-start">
            <h1 class="text-2xl font-bold mr-4 mb-2 md:mb-0">Iwan Ingman</h1>
          </div>
          <nav class="flex flex-row md:flex-col items-start relative overflow-scroll px-4 md:px-0 pb-4 md:pb-0 fade md:overflow-auto scroll-pr-6 md:relative">
            <a href="/" class="text-sm font-medium text-gray-500 hover:text-gray-900 mr-4 md:mr-0 mb-2 md:mb-4">Home</a>
            <a href="/blog" class="text-sm font-medium text-gray-500 hover:text-gray-900 mr-4 md:mr-0 mb-2 md:mb-4">Blog</a>
          </nav>
        </div>
      </aside>
      <main class="flex-auto min-w-0 mt-6 md:mt-0 flex flex-col">
        <slot />
      </main>
    </div>
    <script is:inline>
      function loadGiscus() {
        const container = document.getElementById("giscus");
        if (!container) return;

        // If Giscus already exists, do nothing
        if (container.querySelector("iframe")) return;

        const script = document.createElement("script");
        script.src = "https://giscus.app/client.js";
        script.async = true;
        script.crossOrigin = "anonymous";

        script.setAttribute("data-repo", "iwanidev/astro-blog-site");
        script.setAttribute("data-repo-id", "R_kgDORs8Kcg");
        script.setAttribute("data-category", "Comments");
        script.setAttribute("data-category-id", "DIC_kwDORs8Kcs4C6nPl");
        script.setAttribute("data-mapping", "pathname");
        script.setAttribute("data-strict", "0");
        script.setAttribute("data-reactions-enabled", "1");
        script.setAttribute("data-emit-metadata", "0");
        script.setAttribute("data-input-position", "bottom");
        script.setAttribute("data-theme", "catppuccin_macchiato");
        script.setAttribute("data-lang", "en");

        container.appendChild(script);
      }

      function resetGiscus() {
        const container = document.getElementById("giscus");
        if (container) container.innerHTML = "";
      }

      // Initial load
      loadGiscus();

      // Reload on Astro client navigation
      document.addEventListener("astro:page-load", () => {
        resetGiscus();
        loadGiscus();
      });
</script>
  </body>
</html>

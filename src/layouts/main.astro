---
import "@/styles/global.css"
import Footer from "@/components/Footer.astro";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Astro App",
  description = "Astro blog"
} = Astro.props as Props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body class="flex flex-col min-h-screen bg-slate-800 text-gray-900">
    <div class="max-w-5xl mb-40 flex flex-col md:flex-row mx-4 mt-8 md:mt-20 lg:mt-32 lg:mx-auto">
      <aside class="md:w-[200px] md:shrink-0 -mx-4 md:mx-0 md:px-0">
        <div class="lg:sticky lg:top-20">
          <div class="mb-8 px-4 md:px-0 flex flex-col md:flex-row items-start">
            <h1 class="text-2xl font-bold mr-4 mb-2 md:mb-0">Iwan Ingman</h1>
          </div>
          <nav class="flex flex-row md:flex-col items-start relative overflow-scroll px-4 md:px-0 pb-4 md:pb-0 fade md:overflow-auto scroll-pr-6 md:relative">
            <a href="/" class={`text-sm font-medium ${Astro.url.pathname === '/' ? 'text-gray-500' : 'text-gray-500'} hover:text-gray-900 mr-4 md:mr-0 mb-2 md:mb-4`}>Home</a>
            <a href="/blog" class={`text-sm font-medium ${Astro.url.pathname === '/blog' || Astro.url.pathname.startsWith("/posts/") ? 'text-gray-500' : 'text-gray-500'} hover:text-gray-900 mr-4 md:mr-0 mb-2 md:mb-4`}>Blog</a>
          </nav>
        </div>
      </aside>
      <div class="flex-grow min-w-0 mt-6 md:mt-0 flex flex-col">
        <main class="flex-grow min-w-0 fade flex flex-col gap-y-4">
          <slot />
        </main>
        <footer class="px-4 md:px-0 mt-8">
          <Footer />
        </footer>
      </div>
    </div>
    <script is:inline>
      const remark42Host = "https://comments.iwaningman.com";
      const remark42SiteId = "www.iwaningman.com";
      const remark42ScriptId = "remark42-embed-script";

      let remark42Instance = null;

      function getRemark42Url() {
        return window.location.origin + window.location.pathname;
      }

      function setRemark42Config() {
        window.remark_config = {
          host: remark42Host,
          site_id: remark42SiteId,
          url: getRemark42Url(),
          page_title: document.title,
          theme: "dark",
          components: ["embed"],
        };
      }

      function loadRemark42Script() {
        setRemark42Config();

        if (document.getElementById(remark42ScriptId)) return;

        const script = document.createElement("script");
        script.id = remark42ScriptId;
        script.async = true;
        script.defer = true;
        script.src = `${remark42Host}/web/embed.js`;
        document.body.appendChild(script);
      }

      function destroyRemark42() {
        if (remark42Instance) {
          remark42Instance.destroy();
          remark42Instance = null;
        }
      }

      function mountRemark42() {
        const container = document.getElementById("remark42");
        if (!container) return;

        if (!window.REMARK42) return;

        setRemark42Config();
        destroyRemark42();
        container.innerHTML = "";
        remark42Instance = window.REMARK42.createInstance({
          node: container,
          host: remark42Host,
          site_id: remark42SiteId,
          url: getRemark42Url(),
          page_title: document.title,
          theme: "dark",
          components: ["embed"],
        });
      }

      function initRemark42() {
        destroyRemark42();

        const container = document.getElementById("remark42");
        if (!container) return;

        loadRemark42Script();

        if (window.REMARK42) {
          mountRemark42();
          return;
        }

        window.addEventListener("REMARK42::ready", mountRemark42, { once: true });
      }

      initRemark42();

      document.addEventListener("astro:page-load", () => {
        initRemark42();
      });
</script>
  </body>
</html>

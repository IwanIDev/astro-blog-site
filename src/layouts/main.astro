---
import "@/styles/global.css"
import Footer from "@/components/Footer.astro";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Astro App",
  description = "Astro blog"
} = Astro.props as Props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body class="flex flex-col min-h-screen bg-slate-800 text-gray-900">
    <div class="mb-40 flex w-full max-w-7xl flex-col md:flex-row gap-0 px-4 mt-8 md:mt-20 lg:mt-32 lg:px-12 mx-auto">
      <aside class="md:w-[200px] md:shrink-0 -mx-4 md:mx-0 md:px-0">
        <div class="lg:sticky lg:top-20">
          <div class="mb-8 px-4 md:px-0 flex flex-col md:flex-row items-start">
            <h1 class="text-2xl font-bold mr-4 mb-2 md:mb-0">Iwan Ingman</h1>
          </div>
          <nav class="flex flex-row md:flex-col items-start relative overflow-scroll px-4 md:px-0 pb-4 md:pb-0 fade md:overflow-auto scroll-pr-6 md:relative">
            <a href="/" class={`text-sm font-medium ${Astro.url.pathname === '/' ? 'text-gray-500' : 'text-gray-500'} hover:text-gray-900 mr-4 md:mr-0 mb-2 md:mb-4`}>Home</a>
            <a href="/posts" class={`text-sm font-medium ${Astro.url.pathname === '/blog' || Astro.url.pathname.startsWith("/posts/") ? 'text-gray-500' : 'text-gray-500'} hover:text-gray-900 mr-4 md:mr-0 mb-2 md:mb-4`}>Blog</a>
          </nav>
        </div>
      </aside>
      <div class="mt-6 md:mt-0 flex min-w-0 flex-1 flex-col">
        <main class="flex min-w-0 flex-1 flex-col gap-y-4 fade">
          <slot />
        </main>
        <footer class="px-4 md:px-0 mt-8">
          <Footer />
        </footer>
      </div>
    </div>
  </body>
</html>

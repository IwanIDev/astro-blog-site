---
import { ViewTransitions } from "astro:transitions";
import "@/styles/global.css"

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Astro App",
  description = "Astro blog"
} = Astro.props as Props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <ViewTransitions />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body>
    <slot />
    <script is:inline>
      function loadGiscus() {
        const container = document.getElementById("giscus");
        if (!container) return;

        // If Giscus already exists, do nothing
        if (container.querySelector("iframe")) return;

        const script = document.createElement("script");
        script.src = "https://giscus.app/client.js";
        script.async = true;
        script.crossOrigin = "anonymous";

        script.setAttribute("data-repo", "iwanidev/astro-blog-site");
        script.setAttribute("data-repo-id", "R_kgDORs8Kcg");
        script.setAttribute("data-category", "Comments");
        script.setAttribute("data-category-id", "DIC_kwDORs8Kcs4C6nPl");
        script.setAttribute("data-mapping", "pathname");
        script.setAttribute("data-strict", "0");
        script.setAttribute("data-reactions-enabled", "1");
        script.setAttribute("data-emit-metadata", "0");
        script.setAttribute("data-input-position", "bottom");
        script.setAttribute("data-theme", "catppuccin_macchiato");
        script.setAttribute("data-lang", "en");

        container.appendChild(script);
      }

      function resetGiscus() {
        const container = document.getElementById("giscus");
        if (container) container.innerHTML = "";
      }

      // Initial load
      loadGiscus();

      // Reload on Astro client navigation
      document.addEventListener("astro:page-load", () => {
        resetGiscus();
        loadGiscus();
      });
</script>
  </body>
</html>

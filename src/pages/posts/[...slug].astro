---
import { getCollection, type CollectionEntry } from "astro:content";
import Layout from "@/layouts/main.astro";
import { buttonVariants } from "@/components/ui/button";
import BlogPostCard from "@/components/BlogPostCard.astro";
import OpenRing from "@/components/OpenRing.astro";
import Comments from "@/components/Comments.astro";

export async function getStaticPaths() {
  const posts = await getCollection("blog");

  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props as Props;
const { Content } = await post.render();
---

<Layout title={`${post.data.title} - Iwan Ingman`} description={post.data.description}>
  <div class="flex w-full flex-col gap-8 px-4">
    <div class="flex flex-col text-sm text-muted-foreground">
      <a href="/posts" class="flex items-center gap-1">
        <span class="transition-colors hover:text-primary">← Back to Posts</span>
      </a>
      <BlogPostCard
        title={post.data.title}
        slug={post.id}
        description={post.data.description}
        author={post.data.author}
        publishDate={post.data.publishDate}
      />
    </div>

    <article class="space-y-4 leading-relaxed" id="article">
      <Content />
    </article>

    <OpenRing />

    <Comments />

  </main>
</Layout>

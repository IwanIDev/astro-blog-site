---
import Layout from "@/layouts/main.astro"
import BlogPosts from "@/components/BlogPosts.astro"
import OpenRing from "@/components/OpenRing.astro"
import HomePageHeader from "@/components/HomePageHeader.astro"
---

<Layout title="Iwan Ingman's Blog">
  <div class="max-w-5xl mb-40 flex flex-col md:flex-row mx-4 mt-8 md:mt-20 lg:mt-32 lg:mx-auto">
    <aside class="md:w-[200px] md:shrink-0 -mx-4 md:mx-0 md:px-0">
      <div class="lg:sticky lg:top-20">
        <div class="mb-2 px-4 md:px-0 md:mb-20 flex flex-col md:flex-row items-start">
          <h1 class="text-2xl font-bold mr-4 mb-2 md:mb-0">Iwan Ingman</h1>
        </div>
        <nav class="flex flex-row md:flex-col items-start relative overflow-scroll px-4 md:px-0 pb-4 md:pb-0 fade md:overflow-auto scroll-pr-6 md:relative">
          <a href="/" class="text-sm font-medium text-gray-500 hover:text-gray-900 mr-4 md:mr-0 mb-2 md:mb-4">Home</a>
          <a href="/blog" class="text-sm font-medium text-gray-500 hover:text-gray-900 mr-4 md:mr-0 mb-2 md:mb-4">Blog</a>
        </nav>
      </div>
    </aside>
    <main class="flex-auto min-w-0 mt-6 md:mt-0 flex flex-col">
      <h1 class="text-2xl font-bold mb-6">Who am I?</h1>
    </main>
  </div>
</Layout>

